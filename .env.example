# AuditWhy — Open Agent Hackathon 2026 environment template (placeholders only; never commit real values).
# cp .env.example .env, fill in the three values marked REQUIRED FOR LIVE MODE, then: python scripts/live_check.py

# ---------------------------------------------------------------------------
# Server & execution mode
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# true = full agent loop on data/sample/ with no credentials (judges); false = live Zetaris + Nightshift
SAMPLE_MODE=true
# DEBUG/INFO print every trace event; WARNING only revisions, blocks and fallbacks; CRITICAL silences stdout
LOG_LEVEL=INFO
# Optional: isolate traces, ledgers and H-MEM state (defaults to ./logs)
AUDITWHY_LOGS_DIR=
# Admin endpoints (POST /api/credentials) accept loopback callers, or this bearer token from anywhere else.
AUDITWHY_ADMIN_TOKEN=
# Forced on automatically on Vercel: sample mode only, credential editing disabled.
AUDITWHY_PUBLIC_DEMO=false

# ---------------------------------------------------------------------------
# DATA — Zetaris (runs locally in Docker; REST API on 8888, never 8889)
# ---------------------------------------------------------------------------
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
# REQUIRED FOR LIVE MODE — Zetaris UI http://localhost:3000 > Management > API Tokens > + (shown once)
ZETARIS_API_KEY=
# Optional "app-name contact-email" sent to REST sources that require it (never invent one)
ZETARIS_USER_AGENT=
SOURCE_TIMEOUT_SECONDS=30
# Optional: canonical->live table names (inline JSON or file path); default data/zetaris_table_map.json
ZETARIS_TABLE_MAP=

# ---------------------------------------------------------------------------
# POWER — Meterless Nightshift (primary AI provider, OpenAI-compatible, runs on your machine)
# ---------------------------------------------------------------------------
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# REQUIRED FOR LIVE MODE — Nightshift > Console (top right) > Runtime access token. 'rt-local' is rejected.
METERLESS_RUNTIME_TOKEN=
# Alternatives: paste a Quick Connect link (http://<host>:<port>/connect#k=...), or point at <stateDir>/proxy-token
METERLESS_CONNECT_LINK=
METERLESS_TOKEN_FILE=
METERLESS_APP_NAME=auditwhy
# Optional pinned routing mode (e.g. a Nemotron-backed lane). Empty = per-task: text.fast / judge.deep / text.auto
METERLESS_MODEL=

# ---------------------------------------------------------------------------
# NVIDIA Nemotron
# The setup guide puts the NVIDIA key (nvapi-...) in Nightshift > Providers > NVIDIA, NOT here.
# Only fill these to enable the optional direct fallback route ("Option B"); base URL, key and model IDs
# must all come from the same route (build.nvidia.com).
# ---------------------------------------------------------------------------
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_DEEP_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_SYNTH_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Generic names from the hackathon templates (aliases of the NVIDIA_* values above)
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# ---------------------------------------------------------------------------
# Engines & policy
# ---------------------------------------------------------------------------
# Scout contract signing key. Blank = random per process (contracts are verified only in-process).
SCOUT_HMAC_KEY=
SCOUT_RATE_LIMIT_PER_MINUTE=120
# Summary-SIC reconciliation: primary_leaf (SIC "...1" convention, default) | peer_majority
AUDITWHY_SIC_LEAF_POLICY=primary_leaf
# Only for broken local CA stores; applies to the public, credential-free SEC/SIC probe, never to keyed calls.
AUDITWHY_ALLOW_INSECURE_TLS=false
