# AuditWhy — Open Agent Hackathon 2026 Environment Configuration
# Copy this file to .env and populate with your live credentials.
# Never commit real API keys or tokens to version control.

# Server & Execution Mode
PORT=8000
SAMPLE_MODE=true
LOG_LEVEL=INFO

# Zetaris Data Layer (Default port 8888, never 8889)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=
ZETARIS_ORG_ID=1

# Meterless Nightshift Runtime 1.4 (Provider Contract v4)
# Note: Do not use placeholder 'rt-local' (rejected by contract v4).
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_API_KEY=
METERLESS_CONNECT_LINK=
METERLESS_APP_NAME=auditwhy

# NVIDIA NIM / Nemotron Fallback
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
MODEL_API_KEY=
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_DEEP_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_SYNTH_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Scout Intent Execution Contract Signing Key (Non-secret default for local verification)
SCOUT_HMAC_KEY=auditwhy-scout-contract-v1
